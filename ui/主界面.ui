  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background: #f3f6fb;
}
QWidget {
    color: #1f2937;
    font-family: &quot;Microsoft YaHei UI&quot;;
    font-size: 13px;
}
QGroupBox {
    background: #ffffff;
    border: 1px solid #d8e0ec;
    border-radius: 10px;
    margin-top: 14px;
    padding-top: 10px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
    color: #334155;
}
QGroupBox#groupBoxMangoAssistant::title {
    color: #b45309;
}
QLabel {
    color: #334155;
}
QLineEdit, QComboBox, QDateTimeEdit, QDoubleSpinBox, QPlainTextEdit {
    background: #fbfdff;
    border: 1px solid #cfd8e6;
    border-radius: 7px;
    padding: 6px 8px;
    min-height: 22px;
}
QComboBox {
    padding-right: 24px;
}
QComboBox::drop-down, QDateTimeEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border: none;
    background: transparent;
    margin-right: 2px;
}
QComboBox::drop-down:hover, QDateTimeEdit::drop-down:hover {
    background: #eef4ff;
    border-radius: 6px;
}
QComboBox::down-arrow, QDateTimeEdit::down-arrow {
    width: 9px;
    height: 9px;
}
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    width: 18px;
    border: none;
    background: transparent;
}
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
    background: #eef4ff;
    border-radius: 5px;
}
QDoubleSpinBox::up-arrow, QDoubleSpinBox::down-arrow {
    width: 8px;
    height: 8px;
}
QLineEdit:focus, QComboBox:focus, QDateTimeEdit:focus, QDoubleSpinBox:focus, QPlainTextEdit:focus {
    border: 1px solid #2f7cf6;
}
QPushButton {
    background: #f7f9fe;
    border: 1px solid #cfd8e6;
    border-radius: 8px;
    padding: 7px 14px;
    font-weight: 600;
}
QPushButton:hover {
    background: #eef4ff;
}
QPushButton#pushButtonRun {
    background: #2563eb;
    border: 1px solid #1d4ed8;
    color: #ffffff;
}
QPushButton#pushButtonRun:hover {
    background: #1d4ed8;
}
QPushButton#pushButtonMangoSend {
    background: #f59e0b;
    border: 1px solid #d97706;
    color: #ffffff;
}
QPushButton#pushButtonMangoSend:hover {
    background: #d97706;
}
QPushButton#pushButtonReset {
    background: #ffffff;
}
QProgressBar {
    min-height: 14px;
    border-radius: 7px;
    border: 1px solid #d7ddea;
    background: #edf2fa;
    text-align: center;
}
QProgressBar::chunk {
    border-radius: 6px;
    background: #2f7cf6;
}
QLabel#labelMapTitle {
    font-size: 12px;
    font-weight: 600;
    color: #334155;
}
QStatusBar {
    background: #ffffff;
    border-top: 1px solid #d8e0ec;
}</string>
